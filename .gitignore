node_modules/
dist/
.env
# Committed on purpose: VITE_* values are inlined into the client bundle at build
# time, so Render's build machine must have this file or the site crashes on load.
# These values ship publicly in every browser bundle and inside the APK anyway.
!/.env.production
backend/supabase-config.json
backend/.env
backend/*.local
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/keystore.properties
android/app/*.keystore
*.log
.DS_Store
*.apk
# The update banner downloads this from the server, so it must ship with the repo.
!JSR-Lending.apk
*.zip
