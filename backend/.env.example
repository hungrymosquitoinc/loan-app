# Copy to .env and fill in real values, OR set these in your cloud host dashboard (Railway/Render env vars)
NODE_ENV=production
PORT=3001

# --- Supabase (required; use the same values as backend/supabase-config.json) ---
SUPABASE_URL=https://ywfthihddyvhskwserta.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_SECRET_KEY=your-secret-key-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# --- CORS: comma-separated list of origins allowed to call the API ---
# Android Capacitor WebView uses https://localhost as its origin
ALLOWED_ORIGINS=https://localhost,capacitor://localhost

# --- Network ---
# Set to true so express-rate-limit + client IP work behind Render's proxy
TRUST_PROXY=true
